# mock = data dummy in-memory (default); http = API backend
VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Viewer SCADA pihak ketiga yang disematkan di menu SCADA (opsional).
