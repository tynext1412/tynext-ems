# Data selalu dari API backend (repo tynext-mqtt). Pilihan lama (data dummy) dinonaktifkan:
# VITE_DATA_SOURCE=mock
# Backend: https://mqtt-poc.tynext.co.id/api/v1 (VPS). Biarkan /api/v1 supaya lewat proxy Vite (npm run dev) atau
# reverse proxy yang sama dengan dashboard, sehingga cookie sesi satu origin.
VITE_API_BASE_URL=/api/v1
# Build yang di-host di domain lain *.tynext.co.id: pakai URL absolut, dan masukkan origin dashboard ke
# DASHBOARD_ORIGINS di backend.
# VITE_API_BASE_URL=https://mqtt-poc.tynext.co.id/api/v1
# Tujuan proxy /api saat `npm run dev`. Bawaan https://mqtt-poc.tynext.co.id; backend lokal
# (docker compose -f deploy/docker-compose.dev.yml up di tynext-mqtt): http://localhost:8090
# VITE_API_PROXY_TARGET=http://localhost:8090

# Viewer SCADA pihak ketiga yang disematkan di menu SCADA (opsional).
# Mendukung placeholder {plantId}; server SCADA harus mengizinkan embed (X-Frame-Options / CSP).
# VITE_SCADA_URL_TEMPLATE=https://scada.example.com/view/{plantId}?theme=dark
